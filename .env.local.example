# --- TMDB (token v4 "Read Access Token", NO el api_key v3) ---
TMDB_READ_TOKEN=

# --- Upstash Redis (https://upstash.com) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional: solo la necesita el cron que ingesta el top 10 de Netflix; sin ella la app funciona igual, pero esa ingesta no corre.
SUPABASE_SERVICE_ROLE_KEY=

# --- URL pública del sitio (solo producción) ---
# Destino del link del mail de recuperación de contraseña. En Vercel va la URL
# real (https://streamingcentral.vercel.app); en local se deja VACÍA para que
# use el origin del navegador. Si se completa en local, los mails de reset van a
# apuntar a producción.
# Además tiene que estar cargada en Supabase > Authentication > URL Configuration
# (Site URL y Redirect URLs, con /cuenta/reset). Si el redirect no está en esa
# allowlist, Supabase lo ignora y manda el mail al Site URL.
NEXT_PUBLIC_SITE_URL=

# --- Cron de ingesta del top 10 de Netflix (app/api/cron/netflix-top10) ---
# Vercel lo inyecta solo en los requests de Cron; generar un string aleatorio
# largo, por ejemplo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Agenda de Estrenos (Edge Function tmdb-sync) ---
# La service role key NO va en la app Next (nunca al browser). Se setea como
# secret de la Edge Function y la usa el sync para escribir con permisos plenos:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...   (Project Settings > API)
#   supabase secrets set TMDB_READ_TOKEN=...
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY las inyecta Supabase en la función.
