# --- TMDB (token v4 "Read Access Token", NO el api_key v3) ---
TMDB_READ_TOKEN=

# --- Upstash Redis (https://upstash.com) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional: solo la necesita el cron que ingesta el top 10 de Netflix; sin ella la app funciona igual, pero esa ingesta no corre.
SUPABASE_SERVICE_ROLE_KEY=

# --- URL pública del sitio (solo producción) ---
# En Vercel va el dominio CANÓNICO: https://app.yump.ar
# En local se deja VACÍA para que use el origin del navegador. Si se completa en
# local, los mails de reset van a apuntar a producción.
#
# ⚠️ Acá decía "https://streamingcentral.vercel.app". Ese es el dominio ANTERIOR
# y quedó documentado como si fuera el bueno: cualquiera que configurara el
# proyecto siguiendo este archivo lo dejaba mal otra vez.
#
# Quién la consume, en TODO el código (auditado, son dos):
#   1. components/AuthContext.tsx  -> destino del mail de recuperación de
#      contraseña (`${base}/cuenta/reset`). Si está vacía cae al origin del
#      navegador, que en una PWA instalada desde el dominio viejo ES el viejo.
#   2. app/api/recordatorio/route.ts -> el enlace dentro del .ics de
#      "Recordarme". Su respaldo ya es el dominio canónico.
#
# Lo que NO sale de acá: el mail de CONFIRMACIÓN de registro. `signUp` no pasa
# `emailRedirectTo`, así que ese link lo decide únicamente el Site URL del panel
# de Supabase. Cambiar esta variable no lo mueve.
#
# Además tiene que estar cargada en Supabase > Authentication > URL Configuration
# (Site URL y Redirect URLs, con /cuenta/reset). Si el redirect no está en esa
# allowlist, Supabase lo ignora y manda el mail al Site URL.
#
# Estado verificado por el dueño el 29/08/2026:
#   - Vercel: NEXT_PUBLIC_SITE_URL = https://app.yump.ar (Production y Preview)
#   - Supabase Site URL          = https://app.yump.ar
#   - Redirect URLs incluye        https://app.yump.ar/cuenta/reset
#   - Se conservan TEMPORALMENTE localhost y el redirect del dominio anterior.
#   - Recuperacion, confirmacion y compartir: probados y funcionando.
#
# El redirect del dominio anterior se conserva a proposito: la PWA instalada
# desde el dominio viejo todavia necesita llegar al proyecto para recibir
# actualizaciones. NO retirarlo sin decidirlo (docs/CAPACITOR.md 0.a).
NEXT_PUBLIC_SITE_URL=

# --- Cron de ingesta del top 10 de Netflix (app/api/cron/netflix-top10) ---
# Vercel lo inyecta solo en los requests de Cron; generar un string aleatorio
# largo, por ejemplo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Agenda de Estrenos (Edge Function tmdb-sync) ---
# La service role key NO va en la app Next (nunca al browser). Se setea como
# secret de la Edge Function y la usa el sync para escribir con permisos plenos:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...   (Project Settings > API)
#   supabase secrets set TMDB_READ_TOKEN=...
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY las inyecta Supabase en la función.
