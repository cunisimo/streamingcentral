<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Enlaces publicos que abren la app (Android App Links).

                 ACOTADOS A PROPOSITO. Con pathPrefix la app se ofrece SOLO para
                 los enlaces de sala y de ficha; el resto de app.yump.ar sigue
                 abriendo en el navegador, que es lo que la gente espera de un
                 link cualquiera del sitio. Verificar el dominio entero le
                 sacaria a Chrome toda la navegacion del sitio sin que nadie lo
                 haya pedido.

                 android:autoVerify="true" es lo que evita el selector de apps:
                 Android descarga https://app.yump.ar/.well-known/assetlinks.json
                 y comprueba que la huella SHA-256 declarada ahi coincida con la
                 firma del paquete instalado. El archivo esta desplegado (27/09)
                 con las tres huellas de firma de aplicacion; la verificacion en
                 un telefono ("app.yump.ar: verified") sigue PENDIENTE. En
                 Android 12+ un filtro que no verifico NO se ofrece: abre Chrome
                 directamente, que igual lleva a la sala o a la ficha web.

                 El intent lo atiende components/nativo/EnlacesEntrantes.tsx,
                 que cubre los dos casos: app cerrada (getLaunchUrl) y en segundo
                 plano (appUrlOpen), y traduce con lista blanca
                 (lib/enlaces-app.ts). launchMode singleTask, ya declarado
                 arriba, es lo que hace que no se abra una instancia nueva. -->

            <!-- Invitacion a una sala de Yumpea: /sala/<uuid> -> /s/?id=<uuid> -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                    android:host="app.yump.ar"
                    android:pathPrefix="/sala/" />
            </intent-filter>

            <!-- Ficha compartida (el enlace de un match, 28/09):
                 /titulo/movie/<id> y /titulo/tv/<id> -> /t/?tipo=...&id=...
                 Dos prefijos exactos y no "/titulo/" a secas: un enlace con otro
                 tipo no tiene por que abrir la app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                    android:host="app.yump.ar"
                    android:pathPrefix="/titulo/movie/" />
                <data android:scheme="https"
                    android:host="app.yump.ar"
                    android:pathPrefix="/titulo/tv/" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Aviso de estreno (@capacitor/local-notifications).

         POST_NOTIFICATIONS es lo unico que se le pide al usuario, y recien
         cuando toca "Recordarme".

         SCHEDULE_EXACT_ALARM SE SACA A PROPOSITO. El manifest del plugin la
         declara, pero un aviso de estreno no necesita precision de alarma: se
         programa a las 10:00 y unos minutos de diferencia no cambian nada. Es
         un permiso sensible -Google Play lo revisa aparte- y pedirlo para esto
         seria injustificable. La app programa con `isExactNotification: false`,
         asi que ademas no se usaria.

         RECEIVE_BOOT_COMPLETED y WAKE_LOCK las declara el plugin y se conservan:
         no son acceso a datos del usuario, son la infraestructura que hace que
         un aviso agendado para dentro de dos semanas sobreviva a un reinicio y
         pueda despertar el telefono para mostrarse. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
</manifest>
