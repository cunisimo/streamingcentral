# Codex de ChatGPT trabaja sobre esta carpeta como auditor (lee, no modifica).
# Su scratch es local y no le sirve a nadie más. `AGENTS.md` SÍ se versiona:
# es el puntero que lo manda a CLAUDE.md.
.codex/

# Supabase CLI scratch
supabase/.temp/

# Pipeline de curado — se ignora todo salvo lo que costó cuota de LLM
# o trabajo humano. Lo demás se rebaja de TMDB.
data/*
!data/copy-ruleta.json
!data/contexto-ruleta.json
!data/clasificado-magica-navidad.json

# Permisos locales de Claude Code. NO se versiona y NO se lee: es configuracion
# de la maquina del dueno, no del proyecto (`.claude/settings.json` y
# `launch.json` SI se versionan, que es la parte compartida).
#
# Estaba protegido SOLO por el ignore global de esta maquina
# (~/.config/git/ignore), asi que en cualquier otro clon un `git add -A` lo
# habria incluido. Aca la proteccion viaja con el repo.
.claude/settings.local.json

# Build de la cascara para Capacitor. Los tres son artefactos y se regeneran.
# .capacitor-diagnostico: salida del export de DIAGNOSTICO (CP1).
# .capacitor-build:       workspace de staging (CP2).
# out-capacitor:          la cascara final, el webDir del contenedor.
.capacitor-diagnostico/
.capacitor-build/
out-capacitor/
