# Entorno para correr `next dev` y las pruebas de las salas contra la base LOCAL
# de `supabase start` (plan de salas, Tarea 0.5).
#
#   cp .env.sala-local.example .env.sala-local
#   supabase status            # de acá salen la URL y las dos claves locales
#   node --env-file=.env.sala-local scripts/sala/pruebas-rls.mjs
#
# Las claves locales NO son secretas (las genera el CLI, son las mismas en todas
# las máquinas), pero .env.sala-local está en .gitignore igual: acá también va
# TMDB_READ_TOKEN, que sí lo es. NUNCA poner acá claves de Producción.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sólo para la medición de preparación (Tarea 2.3): enriquecer con TMDB real.
TMDB_READ_TOKEN=

# Sin UPSTASH_*: la caché cae a memoria (lib/cache.ts), que es lo que hace de
# "frío" en la medición. Para "caliente" se repite en el mismo proceso.
