@@ -0,0 +1,27 @@
+// Una barrera para los títulos de una misma tanda: nadie sigue hasta que TODOS
+// tienen sus proveedores.
+//
+// POR QUÉ. Sin proveedores en Argentina, cada título lee después `oficial:`.
+// El batcher de `lib/cache.ts` sólo junta lo que se pide en el mismo
+// tick, y en frío cada `providersOf` vuelve de TMDB en su propio momento: esas
+// lecturas salían de a una, un MGET por clave. Con la barrera todos llegan a la
+// vez y salen en un solo lote.
+//
+// LO QUE NO AHORRA: las escrituras. Cada SET sigue siendo un comando.
+//
+// La barrera se crea POR TANDA, nunca a nivel de módulo: junta sólo lo que se
+// pide en el mismo tick. Espera a todos con `allSettled` para que un título
+// fallido no adelante a los demás; y su error le llega sólo a quien lo pidió.
+export function barreraDeLote<A extends unknown[], R>(
+  leer: (...args: A) => Promise<R>,
+): (...args: A) => Promise<R> {
+  const pendientes: Promise<R>[] = [];
+  let barrera: Promise<unknown> | null = null;
+  return async (...args: A) => {
+    const propia = leer(...args);
+    pendientes.push(propia);
+    barrera ??= Promise.resolve().then(() => Promise.allSettled(pendientes));
+    await barrera;
+    return propia;
+  };
+}
