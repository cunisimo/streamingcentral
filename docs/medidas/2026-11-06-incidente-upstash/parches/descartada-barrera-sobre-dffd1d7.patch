diff --git a/lib/lote-proveedores.test.ts b/lib/lote-proveedores.test.ts
new file mode 100644
index 0000000..108082e
--- /dev/null
+++ b/lib/lote-proveedores.test.ts
@@ -0,0 +1,52 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { barreraDeLote } from "./lote-proveedores.ts";
+
+const diferida = <T>() => {
+  let resolve!: (v: T) => void, reject!: (e: unknown) => void;
+  const promise = new Promise<T>((a, b) => { resolve = a; reject = b; });
+  return { promise, resolve, reject };
+};
+const ticks = async () => { for (let i = 0; i < 10; i++) await Promise.resolve(); };
+
+test("nadie sigue hasta que todos los del mismo tick terminaron", async () => {
+  const a = diferida<string>(), b = diferida<string>();
+  const leer = barreraDeLote(async (k: "a" | "b") => (k === "a" ? a : b).promise);
+  const llegadas: string[] = [];
+  const pa = leer("a").then((v) => { llegadas.push(v); });
+  const pb = leer("b").then((v) => { llegadas.push(v); });
+  a.resolve("A");
+  await ticks();
+  assert.deepEqual(llegadas, [], "el rápido no puede adelantarse");
+  b.resolve("B");
+  await Promise.all([pa, pb]);
+  assert.deepEqual(llegadas, ["A", "B"]);
+});
+
+test("cada uno recibe su valor y la lectura se hace una sola vez por pedido", async () => {
+  let n = 0;
+  const leer = barreraDeLote(async (x: number) => { n++; return x * 2; });
+  assert.deepEqual(await Promise.all([leer(1), leer(2), leer(3)]), [2, 4, 6]);
+  assert.equal(n, 3);
+});
+
+test("un fallo le llega sólo a quien lo pidió y no adelanta a los demás", async () => {
+  const lento = diferida<string>();
+  const leer = barreraDeLote(async (k: string) => {
+    if (k === "falla") throw new Error("429");
+    return lento.promise;
+  });
+  const pf = leer("falla"), pl = leer("lento");
+  let termino = false;
+  void pl.then(() => { termino = true; });
+  await ticks();
+  assert.equal(termino, false);
+  lento.resolve("ok");
+  await assert.rejects(pf, /429/);
+  assert.equal(await pl, "ok");
+});
+
+test("sin nadie más, no se traba", async () => {
+  const leer = barreraDeLote(async () => "solo");
+  assert.equal(await leer(), "solo");
+});
